@Library("Shared") _
pipeline{
    agent any
    
    stages{
        
        stage("Welcome"){
            steps{
                script{
                    jenkins()
                }
            }
        }
        stage("Code Clone"){
            steps{
                script{
                    clone("https://github.com/ankandutta465/devops_practice_2.git", "githubcreds", "main")
                }
            }
        }
        stage("Code Build & Test"){
            steps{
                script{
                    build_test("/var/jenkins_home/workspace/django-todo-delivery/node-todo-cicd-master", "node-todo:latest")
                }
            }
        }
        stage("Push To DockerHub"){
            steps{
                script{
                    dockerPush()
                }
            }
        }
        stage("Deploy"){
            steps{
                dir("/var/jenkins_home/workspace/django-todo-delivery/node-todo-cicd-master"){
                sh "docker compose down && docker compose up -d"
                }
            }
        }
    }
}
